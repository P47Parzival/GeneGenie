# =============================================================================
# BioNexus India V2 — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://bionexus:bionexus_secret@localhost:5432/bionexus
SYNC_DATABASE_URL=postgresql://bionexus:bionexus_secret@localhost:5432/bionexus

# PostgreSQL container credentials (used by docker-compose)
POSTGRES_USER=bionexus
POSTGRES_PASSWORD=bionexus_secret
POSTGRES_DB=bionexus

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Ingestion ---
INGESTION_TIMEOUT=30
INGESTION_MAX_RETRIES=3
INGESTION_BACKOFF_BASE=1

# --- Raw Data Storage ---
RAW_DATA_DIR=data/raw

# --- V2: JWT Authentication ---
# IMPORTANT: Change this to a strong random string in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=bionexus-dev-secret-key-change-in-production-immediately
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- V2: Redis (Celery task queue) ---
REDIS_URL=redis://localhost:6379/0

# --- V2: Email / SMTP ---
# Leave empty for console-only logging (development mode)
# For Gmail: host=smtp.gmail.com, port=587, use app password
# For SendGrid: host=smtp.sendgrid.net, port=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@bionexus.in
SMTP_FROM_NAME=BioNexus India
SMTP_USE_TLS=true

# --- V2: File Uploads ---
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=10
