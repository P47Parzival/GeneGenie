# Copy to .env.local (local dev) or set in your Vercel project settings.

# Server-side base used by the Next.js /api proxy routes and the gene-summary
# server component. Local dev can point straight at the EC2 instance.
ANNOTATION_API_BASE=http://3.6.214.176:8000

# Browser-facing API base. Set this in PRODUCTION (Vercel) to the HTTPS API
# domain so the browser calls the API directly — this bypasses Vercel's
# serverless ~4.5 MB request-body cap and function timeouts on VCF uploads.
# Leave UNSET locally to use the same-origin /api proxy.
#   Production:  NEXT_PUBLIC_ANNOTATION_API_BASE=https://api.genegenie.tech
# NEXT_PUBLIC_ANNOTATION_API_BASE=
